  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "05-8\r\n\r\nSomething in our timeline is wrong, very wong. It appears
    as if a year passed and we all, forgot? What happened? How is it possible than
    nobody on this planet knows what or how that happened? Did we do something wrong?
    If we did, did we fix it? did we not? How can we possible learn and improve on
    our mistakes when we don\u2019t even know they happened?\r\nSomething is playing
    with our minds, i will call a meeting tomorrow to invent the Noospherics division.
    We need to find out what happened and prevent it from happening again|\r\n\r\n05-8
    deep inside him truly believes that this has happened again, but doesn\u2019t
    want to believe it\r\n"
